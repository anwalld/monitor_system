# 复制为 deploy/.env 后填写；.env 已被 .gitignore 忽略，不要提交。
# 三个密码为必填，留空时 docker compose 拒绝启动。
# 注意：值里不要写行内注释；密码含 $ 时写成 $$。

# Redis（必填）
REDIS_PASSWORD=
REDIS_PORT=6379

# MySQL（两个密码必填）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=lm
MYSQL_USER=lm
MYSQL_PORT=3306

# 看板（M7）：API_TOKEN 为空时看板接口不鉴权；首次打开 http://<主机>/#/?token=<API_TOKEN> 会记住 token
API_TOKEN=
HTTP_PORT=80

# AI 服务（M8）：只监听 127.0.0.1，经 Nginx /api/ai/ 访问
AI_PORT=8000
# LLM 厂商 API Key（按需填写；在看板“设置”页选择厂商和模型，Key 不经过前端）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
